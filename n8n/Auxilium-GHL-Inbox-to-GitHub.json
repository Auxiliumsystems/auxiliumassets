{
  "name": "Auxilium – GHL Content Inbox to GitHub library",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [ { "field": "minutes", "minutesInterval": 10 } ] } },
      "id": "c3a0d001-0000-4000-8000-000000000001",
      "name": "Every 10 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "return [\n  { json: { folderId: '6af79b7ce3f654f61a806eaf', folder: 'content-inbox' } },\n  { json: { folderId: '6af79b7ffdf6b54fd70e21e8', folder: 'auxilium' } },\n  { json: { folderId: '6af79b7f412efdb47867e149', folder: 'rob-personal-brand' } }\n];"
      },
      "id": "c3a0d001-0000-4000-8000-000000000002",
      "name": "The 3 inbox folders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 0]
    },
    {
      "parameters": {
        "url": "https://services.leadconnectorhq.com/medias/files",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "altId", "value": "dYYAuu3AKjoEoCoovFmE" },
            { "name": "altType", "value": "location" },
            { "name": "type", "value": "file" },
            { "name": "parentId", "value": "={{ $json.folderId }}" },
            { "name": "sortBy", "value": "updatedAt" },
            { "name": "sortOrder", "value": "desc" },
            { "name": "limit", "value": "50" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Version", "value": "2021-07-28" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "c3a0d001-0000-4000-8000-000000000003",
      "name": "List files in GHL folder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 0],
      "alwaysOutputData": true,
      "credentials": { "httpHeaderAuth": { "id": "", "name": "GHL Auxilium private token" } }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nconst MAX = 45 * 1024 * 1024; // GitHub upload limit we stay under\nfor (const item of $input.all()) {\n  const files = item.json.files || [];\n  for (const f of files) {\n    const type = f.contentType || '';\n    if (!(type.startsWith('video/') || type.startsWith('image/') || type.startsWith('audio/'))) continue;\n    if ((f.size || 0) > MAX) continue;\n    const dot = (f.name || '').lastIndexOf('.');\n    const base = dot > 0 ? f.name.slice(0, dot) : f.name;\n    const ext = dot > 0 ? f.name.slice(dot + 1).toLowerCase() : 'bin';\n    const slug = base.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 80);\n    out.push({ json: { name: f.name, url: f.url, size: f.size, path: 'inbox/' + slug + '.' + ext } });\n  }\n}\nreturn out;"
      },
      "id": "c3a0d001-0000-4000-8000-000000000004",
      "name": "Pick media files under 45 MB",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 0]
    },
    {
      "parameters": {
        "url": "={{ 'https://api.github.com/repos/Auxiliumsystems/auxiliumassets/contents/' + $json.path }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "User-Agent", "value": "auxilium-n8n" }
          ]
        },
        "options": { "response": { "response": { "fullResponse": true, "neverError": true } } }
      },
      "id": "c3a0d001-0000-4000-8000-000000000005",
      "name": "Already in library?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 0],
      "credentials": { "httpHeaderAuth": { "id": "", "name": "GitHub token" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.statusCode }}", "rightValue": 404, "operator": { "type": "number", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c3a0d001-0000-4000-8000-000000000006",
      "name": "Not copied yet",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1000, 0]
    },
    {
      "parameters": {
        "url": "={{ $('Pick media files under 45 MB').item.json.url }}",
        "options": { "response": { "response": { "responseFormat": "file", "outputPropertyName": "data" } } }
      },
      "id": "c3a0d001-0000-4000-8000-000000000007",
      "name": "Download from GHL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, -100]
    },
    {
      "parameters": { "operation": "binaryToPropery", "binaryPropertyName": "data", "destinationKey": "b64", "options": {} },
      "id": "c3a0d001-0000-4000-8000-000000000008",
      "name": "File to text (base64)",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [1400, -100]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ 'https://api.github.com/repos/Auxiliumsystems/auxiliumassets/contents/' + $('Pick media files under 45 MB').item.json.path }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "User-Agent", "value": "auxilium-n8n" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: 'Inbox copy: ' + $('Pick media files under 45 MB').item.json.name, content: $json.b64, branch: 'main' }) }}",
        "options": { "timeout": 300000 }
      },
      "id": "c3a0d001-0000-4000-8000-000000000009",
      "name": "Save to GitHub library",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1600, -100],
      "credentials": { "httpHeaderAuth": { "id": "", "name": "GitHub token" } }
    }
  ],
  "connections": {
    "Every 10 minutes": { "main": [[{ "node": "The 3 inbox folders", "type": "main", "index": 0 }]] },
    "The 3 inbox folders": { "main": [[{ "node": "List files in GHL folder", "type": "main", "index": 0 }]] },
    "List files in GHL folder": { "main": [[{ "node": "Pick media files under 45 MB", "type": "main", "index": 0 }]] },
    "Pick media files under 45 MB": { "main": [[{ "node": "Already in library?", "type": "main", "index": 0 }]] },
    "Already in library?": { "main": [[{ "node": "Not copied yet", "type": "main", "index": 0 }]] },
    "Not copied yet": { "main": [[{ "node": "Download from GHL", "type": "main", "index": 0 }], []] },
    "Download from GHL": { "main": [[{ "node": "File to text (base64)", "type": "main", "index": 0 }]] },
    "File to text (base64)": { "main": [[{ "node": "Save to GitHub library", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
