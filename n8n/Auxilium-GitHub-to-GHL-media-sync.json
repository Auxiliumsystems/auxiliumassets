{
  "name": "Auxilium – GitHub to GHL media sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000001",
      "name": "Every 10 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "=https://raw.githubusercontent.com/Auxiliumsystems/auxiliumassets/main/library/to-ghl.json?t={{ $now.toMillis() }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000002",
      "name": "Read upload queue from GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000003",
      "name": "One item per file",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "url": "https://services.leadconnectorhq.com/medias/files",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "altId", "value": "dYYAuu3AKjoEoCoovFmE" },
            { "name": "altType", "value": "location" },
            { "name": "type", "value": "file" },
            { "name": "query", "value": "={{ $json.name }}" },
            { "name": "sortBy", "value": "createdAt" },
            { "name": "sortOrder", "value": "desc" },
            { "name": "limit", "value": "5" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Version", "value": "2021-07-28" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000004",
      "name": "Already in GHL?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0],
      "alwaysOutputData": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "GHL Auxilium private token"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c0000000-0000-4000-8000-000000000001",
              "leftValue": "={{ ($json.files || []).filter(f => f.name === $('One item per file').item.json.name).length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000005",
      "name": "Not uploaded yet",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "url": "={{ 'https://raw.githubusercontent.com/Auxiliumsystems/auxiliumassets/main/' + $('One item per file').item.json.path }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000006",
      "name": "Download file from GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/medias/upload-file",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Version", "value": "2021-07-28" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            },
            {
              "name": "name",
              "value": "={{ $('One item per file').item.json.name }}"
            },
            {
              "name": "parentId",
              "value": "={{ $('One item per file').item.json.parentId }}"
            },
            {
              "name": "hosted",
              "value": "false"
            }
          ]
        },
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000007",
      "name": "Upload real copy to GHL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, -100],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "GHL Auxilium private token"
        }
      }
    }
  ],
  "connections": {
    "Every 10 minutes": {
      "main": [[{ "node": "Read upload queue from GitHub", "type": "main", "index": 0 }]]
    },
    "Read upload queue from GitHub": {
      "main": [[{ "node": "One item per file", "type": "main", "index": 0 }]]
    },
    "One item per file": {
      "main": [[{ "node": "Already in GHL?", "type": "main", "index": 0 }]]
    },
    "Already in GHL?": {
      "main": [[{ "node": "Not uploaded yet", "type": "main", "index": 0 }]]
    },
    "Not uploaded yet": {
      "main": [
        [{ "node": "Download file from GitHub", "type": "main", "index": 0 }],
        []
      ]
    },
    "Download file from GitHub": {
      "main": [[{ "node": "Upload real copy to GHL", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
